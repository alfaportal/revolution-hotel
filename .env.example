PORT=8080
NODE_ENV=production

PRODUCT_LINE=hotel
SUPABASE_URL=https://mnzmbgaqtdxrtutfjesr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Nëse s'ke service_role ende, mund të përdorësh anon:
# SUPABASE_KEY=

# Për migrime SQL lokale (Settings → Database → Connection string → URI)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Krijohet automatikisht në start nëse nuk ekziston super admin
SUPER_ADMIN_EMAIL=admin@revolutioninvest.com
SUPER_ADMIN_PASSWORD=change-me-on-first-login
SUPER_ADMIN_NAME=Super Admin

# Opsionale: kërko header për validim licence nga POS
LICENSE_API_KEY=

# Master Admin i unifikuar: https://revolution-pos.com/admin
# ADMIN_PANEL_PATH (p.sh. ri-super) ridrejtohet → /admin/dashboard (deprecated)
ADMIN_PANEL_PATH=ri-super

# Bridge Security (Master Admin → SecureTrack) — secret i PËRBASHKËT
# Default: naser-security-2026 (i njëjti si SecureTrack). Nuk duhet secret i veçantë në UI.
# SECURITY_UPSTREAM_URL=https://revolution-security-production.up.railway.app
# SECURITY_ADMIN_SECRET=naser-security-2026
# MASTER_ADMIN_BRIDGE_SECRET=naser-security-2026

# Kodi për regjistrim pronari (vetëm ti e di — vendose në Railway, pastaj ndryshoje)
# Kur është bosh, /owner/register nuk funksionon; pronarët krijohen nga Super Admin.
OWNER_REGISTRATION_CODE=RI-OWNER-2026-CHANGE-ME

# Email — rivendosje fjalëkalimi pronar (pas 2 gabimeve ose manual)
# RESEND_API_KEY=re_...
# EMAIL_FROM=Revolution POS <noreply@ketujemi.com>
PUBLIC_APP_ORIGIN=https://revolution-pos.com

# Stripe — të njëjtat çelësa si KetuJemi (vendosi në Railway, JO në Git)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook URL: https://revolution-pos.com/api/payments/webhook
# Ngjarja: checkout.session.completed
# Çmime (vetëm server — mos i shfaq në webfaqe)
# STRIPE_PRICE_PAKO_1_EUR=150
# STRIPE_PRICE_PAKO_2_EUR=180
# STRIPE_PRICE_PAKO_3_EUR=220
# STRIPE_PRICE_PAKO_4_EUR=250

# SUPPORT_PHONE=+383 48707880
# SUPPORT_EMAIL=revolutioninvest05@gmail.com
# Setup — auto nga GitHub Releases (setup-v* / KAFENE-Setup.exe). Pa pin → versioni i fundit.
# SETUP_DOWNLOAD_SECRET=long-random-secret-for-setup-links
# SETUP_RELEASE_REPO=alfaportal/revolution-pos-server
# SETUP_DOWNLOAD_PINNED=true
# SETUP_DOWNLOAD_URL=https://github.com/.../setup-v1.0.244/KAFENE-Setup.exe
# SETUP_VERSION=1.0.244

# BOT_PAUSED_UNTIL=2026-12-31T23:59:59+02:00
# BOT_PAUSED=1
# TELEGRAM_BOT_PAUSED=1
# Për të hapur BOT-in përsëri: BOT_PAUSED=0 dhe TELEGRAM_BOT_PAUSED=0
# SMS_PAUSED=0
# ADMIN_NOTIFY_EMAIL=novelto22@gmail.com

# Master PIN emergjence — hap çdo POS (online) + gjeneron kod ditor offline
# MASTER_EMERGENCY_PIN=123456

# Kostoja e vlerësuar AI (EUR për 1 000 tokenë — Anthropic Claude Haiku) — për ai_usage_logs
# AI_COST_EUR_PER_1K_CHAT=0.00025
# AI_COST_EUR_PER_1K_SCAN=0.0023
# AI_COST_EUR_PER_1K_REPORT=0.00025
# AI_USD_TO_EUR=0.92

# AI chat — njëri prej këtyre (ose AI_PROVIDER=openai|anthropic)
# AI_PAUSED=0
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# ANTHROPIC_VISION_MODEL=claude-3-5-haiku-latest
# AI_CHAT_MAX_TOKENS=1024
# AI_SCAN_MAX_TOKENS=4096

# Raporte AI ditore — cron në 23:59 (timezone)
# REPORT_CRON_TZ=Europe/Belgrade

# Njoftime Telegram / SMS (pako_5)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_ALERT_CHAT_ID=123456789
# TELEGRAM_SUPER_ADMIN_IDS=8463714362
# (Vetëm këto chat ID mund të përdorin /status /restart /backup /logs)
# TELEGRAM_WEBHOOK_URL=https://revolution-pos.com/api/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=random-secret-string
# RAILWAY_TOKEN=
# RAILWAY_SERVICE_ID=
# RAILWAY_ENVIRONMENT_ID=
# BACKUP_HEALTH_URL=https://backup1.revolution-pos.com/health
# VONAGE_API_KEY=
# VONAGE_API_SECRET=
# VONAGE_FROM=RevolutionPOS
